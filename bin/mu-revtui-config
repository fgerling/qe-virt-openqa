#!/usr/bin/env python3
"""Generate the openqa-revtui config for the MU review round.

  mu-revtui-config              write etc/revtui-mu.toml
  mu-revtui-config -o -         print to stdout instead
  mu-revtui-config -b 5         keep 5 builds per group instead of 10

openqa-revtui's /tests/overview query returns the current build of a group only.
The MU groups carry a couple of dozen open incident builds at once, so a config
naming just the group would hide almost everything. gopenqa's mergeParams splits
a comma-separated value into repeated query parameters, and openQA honours
build=A&build=B, so listing the builds explicitly makes revtui show all of them.

Those builds change as incidents come and go, which is why this is generated
rather than hand-written. Re-run it at the start of a review round.

The group IDs are read from etc/job-groups; group names come from the API. Read-only: only GET requests, no API key needed.
"""

import argparse
import json
import sys
import urllib.parse
import urllib.request
from pathlib import Path

OSD = "https://openqa.suse.de"
HERE = Path(__file__).resolve().parent
JOB_GROUPS = HERE.parent / "etc" / "job-groups"
DEFAULT_OUT = HERE.parent / "etc" / "revtui-mu.toml"

HEADER = """\
## openqa-revtui configuration for the QE-Virt maintenance update review round.
##
##   openqa-revtui -c etc/revtui-mu.toml      (from the repo root)
##
## GENERATED by bin/mu-revtui-config -- do not edit by hand, your changes will be
## overwritten. The build lists below go stale as incidents come and go; re-run
## the generator at the start of a review round.
##
## Read-only: revtui only issues GET requests and subscribes to RabbitMQ. It
## cannot schedule, restart or cancel anything.

Instance = "https://openqa.suse.de"

# Public credentials, the same ones openqa-mq bakes in for --osd.
RabbitMQ = "amqps://suse:suse@rabbit.suse.de"
RabbitMQTopic = "suse.openqa.job.done"

# Show only what still needs a reviewer.
#
# "reviewed" is not an openQA state -- revtui synthesises it for a failed,
# incomplete or parallel_failed job that already carries a bugref (bsc#/poo#) in
# one of its comments. Hiding it is what turns this into a TODO list.
#
# "softfailed" is hidden outright because "reviewed" does not apply to it
# (openqa-revtui/tui.go:293), so a bugref'd softfail would never go away. Drop it
# from this list during a soft-failure sweep.
#
# "parallel_failed" is hidden because the sibling that actually died shows up as
# "failed" anyway. Keep it if you would rather see whole migration pairs at once.
HideStatus = [
    "scheduled",
    "assigned",
    "running",
    "uploading",
    "passed",
    "softfailed",
    "cancelled",
    "user_cancelled",
    "skipped",
    "parallel_failed",
    "reviewed",
]

RefreshInterval = 60
MaxJobs = 200
GroupBy = "groups"
RequestJobLimit = 100

# No DefaultParams on purpose: these groups span distri=sle and distri=sle-micro,
# and a global distri would silently empty out whichever half it does not match.
# groupid plus the explicit build list already pins every query.
"""


def get_json(url):
    with urllib.request.urlopen(url) as response:
        return json.load(response)


def read_group_ids(path):
    """Job group IDs from etc/job-groups, comments and blank lines dropped."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        sys.exit(f"cannot read the job groups: {exc}")

    gids = []
    for line in lines:
        gids.extend(line.split("#", 1)[0].split())

    # A group name written without its '#' would otherwise be queried as a group.
    bad = [gid for gid in gids if not gid.isdigit()]
    if bad:
        sys.exit(f"{path}: not a job group ID: {', '.join(bad)}")
    if not gids:
        sys.exit(f"{path}: no job group IDs found")
    return gids


def group_name(gid):
    groups = get_json(f"{OSD}/api/v1/job_groups/{gid}")
    if not groups:
        sys.exit(f"group {gid} does not exist on {OSD}")
    return groups[0]["name"]


def recent_builds(gid, count, sample):
    """The `count` most recently seen distinct BUILDs in group `gid`."""
    query = urllib.parse.urlencode({"groupid": gid, "limit": sample})
    jobs = get_json(f"{OSD}/api/v1/jobs?{query}")["jobs"]
    builds = []
    for job in reversed(jobs):  # the API returns oldest-first
        build = job["settings"].get("BUILD")
        if build and build not in builds:
            builds.append(build)
            if len(builds) == count:
                break
    return builds


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("-o", "--output", default=str(DEFAULT_OUT),
                        help="output file, or - for stdout (default: etc/revtui-mu.toml)")
    parser.add_argument("-b", "--builds", type=int, default=10, metavar="N",
                        help="builds to keep per group (default: 10, what group_overview shows)")
    parser.add_argument("-s", "--sample", type=int, default=300, metavar="N",
                        help="recent jobs to scan per group for those builds (default: 300)")
    args = parser.parse_args()

    out = [HEADER]
    for gid in read_group_ids(JOB_GROUPS):
        name = group_name(gid)
        builds = recent_builds(gid, args.builds, args.sample)
        print(f"{gid}: {name} -- {len(builds)} build(s)", file=sys.stderr)
        if not builds:
            out.append(f'\n# {gid} - {name}: no recent builds, skipped\n')
            continue
        # Commas become repeated build= parameters (gopenqa mergeParams).
        build_list = ",".join(builds)
        out.append(f'\n[[Groups]]\nName = "{gid} - {name}"\n'
                   f'Params = {{ groupid = "{gid}", build = "{build_list}" }}\n'
                   f'MaxLifetime = 604800\n')

    text = "".join(out)
    if args.output == "-":
        sys.stdout.write(text)
    else:
        path = Path(args.output)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
        print(f"wrote {path}", file=sys.stderr)


if __name__ == "__main__":
    main()
