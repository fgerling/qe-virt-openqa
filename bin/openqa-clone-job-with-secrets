#!/usr/bin/env python3
"""Clone an openQA job, restoring _SECRET_* settings that the job API redacts.

GET /api/v1/jobs/<id> replaces every setting matching /^_SECRET_|_PASSWORD/
with the literal string "[redacted]". openqa-clone-job reads the job through
that API, so a plain --within-instance clone of a job carrying such settings
writes "[redacted]" into the clone. For virt jobs that means an unparseable
/root/.ssh/id_rsa on the SUT ("error in libcrypto"), ssh falling back to an
interactive password prompt, and the test hanging until it times out.

The unredacted values are readable from the job group's scheduling YAML, so
this looks up each redacted setting there and passes it back explicitly.

Prints what it would run and schedules nothing; pass --execute to clone.

  openqa-clone-job-with-secrets 24036377 PRETTY_SERIAL_MARKER=0 _GROUP=0
  openqa-clone-job-with-secrets --execute 24036377 PRETTY_SERIAL_MARKER=0
  openqa-clone-job-with-secrets --clone-opt=--repeat=10 24036377 FOO=bar
  openqa-clone-job-with-secrets --secrets-only 24036377

Only --within-instance is passed to openqa-clone-job by default. Everything
else goes via --clone-opt. Handy ones, copy-paste as needed:

  --clone-opt=-v                        verbose progress
  --clone-opt=--ignore-missing-assets   clone even if assets are gone from the
                                        instance; needed for jobs with ISO=/HDD_
  --clone-opt=--skip-chained-deps       do NOT clone START_AFTER_TEST parents;
                                        changes the cluster you get, so only
                                        use it deliberately
  --clone-opt=--clone-children          also clone direct children (parallel
                                        children are cloned regardless)
  --clone-opt=--repeat=10               clone N times, for flaky-failure stats

The first three were this script's hardcoded defaults until they were dropped
in favour of being explicit.

Extra KEY=VALUE arguments are forwarded to openqa-clone-job verbatim, so the
usual +=, KEY:test=, and empty-value-to-delete forms all work.
"""
import argparse
import json
import re
import shlex
import subprocess
import sys
import urllib.request

import yaml

REDACTED = "[redacted]"
DEFAULT_HOST = "https://openqa.suse.de"


def parse_args():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("job", metavar="JOB", help="job id, or a job URL")
    p.add_argument("settings", metavar="KEY=VALUE", nargs="*",
                   help="extra settings forwarded to openqa-clone-job")
    p.add_argument("-x", "--execute", action="store_true",
                   help="actually run the clone; without it, only print what would run")
    p.add_argument("--show-secrets", action="store_true",
                   help="print restored values in full instead of abbreviated")
    p.add_argument("--secrets-only", action="store_true",
                   help="print the recovered settings as JSON and exit, for use by "
                        "other tooling; values are never shell-quoted, so consume "
                        "this with a JSON parser rather than command substitution")
    p.add_argument("--host", default=DEFAULT_HOST,
                   help=f"openQA instance (default: {DEFAULT_HOST})")
    p.add_argument("--clone-opt", metavar="OPT", action="append", default=[],
                   help="option for openqa-clone-job, repeatable, e.g. "
                        "--clone-opt=-v --clone-opt=--repeat=10. Must use the "
                        "--clone-opt=X form; argparse will not accept an "
                        "option-looking value after a space")
    args = p.parse_args()
    if m := re.search(r"^(https?://[^/]+).*?/(?:tests/|t/?)(\d+)", args.job):
        args.host, args.job = m.group(1), m.group(2)
    elif not args.job.isdigit():
        p.error(f"cannot parse a job id out of {args.job!r}")
    return args


def get_json(url):
    with urllib.request.urlopen(url) as r:
        return yaml.safe_load(r)  # YAML is a JSON superset; one parser for both


def collect_settings(node, arch, out):
    """Harvest KEY: VALUE pairs from a group YAML, preferring the job's arch.

    Layout is defaults.<arch>.settings, but arch keys vary between groups, so
    walk everything and let the arch-specific block win over any other.
    """
    if isinstance(node, dict):
        for key, value in node.items():
            if isinstance(value, (dict, list)):
                collect_settings(value, arch, out)
            elif isinstance(key, str):
                out.setdefault(key, value)
    elif isinstance(node, list):
        for value in node:
            collect_settings(value, arch, out)


def main():
    args = parse_args()
    api = f"{args.host}/api/v1"

    job = get_json(f"{api}/jobs/{args.job}")["job"]
    redacted = sorted(k for k, v in job["settings"].items() if v == REDACTED)
    if not redacted:
        print(f"job {args.job} has no redacted settings, nothing to restore",
              file=sys.stderr)
    restored = {}

    if redacted:
        group_id = job.get("group_id")
        if not group_id:
            sys.exit(f"job {args.job} has redacted settings {redacted} but no job "
                     "group to recover them from; pass them explicitly")
        arch = job["settings"].get("ARCH", "")
        url = f"{api}/job_templates_scheduling/{group_id}"
        print(f"recovering {len(redacted)} redacted setting(s) from {url}",
              file=sys.stderr)

        available = {}
        # arch-specific block first so it wins the setdefault in collect_settings
        group = get_json(url)
        collect_settings((group.get("defaults") or {}).get(arch, {}), arch, available)
        collect_settings(group, arch, available)

        missing = [k for k in redacted
                   if not available.get(k) or available[k] == REDACTED]
        if missing:
            sys.exit(f"refusing to clone: {', '.join(missing)} still unavailable in "
                     f"group {group_id}; cloning would write '{REDACTED}' into the job")
        restored = {k: available[k] for k in redacted}

    if args.secrets_only:
        json.dump(restored, sys.stdout, indent=2, sort_keys=True)
        print()
        return 0

    # Same-instance only, by design: this exists to work around the redaction
    # bug when re-running a job where it already lives. --within-instance is
    # shorthand for --from HOST --host HOST --skip-download (openqa-clone-job
    # :244). To clone across instances, replace it with separate --from/--host
    # (and keep --skip-download when the target is remote); secret recovery
    # would still read the group YAML from the source instance.
    cmd = ["openqa-clone-job",
           "--within-instance", f"{args.host}/tests/{args.job}"]
    cmd += args.clone_opt
    cmd += [f"{k}={v}" for k, v in restored.items()]
    cmd += args.settings  # last, so an explicit override beats a restored value

    def display(arg):
        key, _, value = arg.partition("=")
        if key in restored and not args.show_secrets:
            markers = value.count("9A")
            return (f"{key}={value[:40]}... [{len(value)} chars"
                    + (f", {markers} 9A newline markers]" if markers else "]"))
        return arg

    if not args.execute:
        print("would execute (one argument per line):")
        for arg in cmd:
            print(f"  {display(arg)}")
        if args.show_secrets:
            print("\nas a single line:")
            print("  " + " ".join(shlex.quote(a) for a in cmd))
        print("\nnothing scheduled; re-run with --execute to clone", file=sys.stderr)
        return 0

    return subprocess.call(cmd)


if __name__ == "__main__":
    sys.exit(main())
